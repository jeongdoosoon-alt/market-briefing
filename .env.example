# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# .env 파일은 절대 다른 사람에게 공유하거나 GitHub에 올리지 마세요.

# Google AI Studio (https://aistudio.google.com/apikey) 에서 발급
GEMINI_API_KEY=

# 사용할 Gemini 모델 (비워두면 gemini-3.8-flash부터 차례로 시도)
GEMINI_MODEL=

# 카카오 개발자 > 내 애플리케이션 > 앱 키 > REST API 키
KAKAO_REST_API_KEY=

# 카카오 로그인 > 보안 > Client Secret 을 "사용함"으로 켠 경우에만 입력
KAKAO_CLIENT_SECRET=

# 카카오 로그인 > Redirect URI 에 등록한 주소와 똑같이 입력
KAKAO_REDIRECT_URI=https://localhost:3000
